{
  "name": "alchemist-clicker",
  "version": "1.0.0",
  "description": "Hyper-casual Alchemist Clicker game built with Phaser.js",
  "scripts": {
    "start": "webpack serve --open",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "test": "jest --coverage"
  },
  "keywords": ["game", "phaser", "clicker", "hyper-casual"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^phaser$": "<rootDir>/tests/__mocks__/phaser.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js",
      "!src/scenes/**"
    ]
  }
}
